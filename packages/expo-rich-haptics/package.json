{
  "name": "@hzblj/expo-rich-haptics",
  "version": "0.1.0",
  "description": "Haptics for Expo that feel like the platform: UIKit feedback and Core Haptics patterns on iOS, the system's haptic feedback and rich primitives on Android, never a vibrator buzz.",
  "author": "Jan Blazej",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzblj/expo-rich-haptics.git",
    "directory": "packages/expo-rich-haptics"
  },
  "bugs": {
    "url": "https://github.com/hzblj/expo-rich-haptics/issues"
  },
  "homepage": "https://github.com/hzblj/expo-rich-haptics#readme",
  "keywords": [
    "android",
    "core-haptics",
    "expo",
    "expo-module",
    "feedback",
    "haptic",
    "haptics",
    "ios",
    "react-native",
    "taptic",
    "vibration"
  ],
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./expo-module.config.json": "./expo-module.config.json",
    "./package.json": "./package.json"
  },
  "files": [
    "android/build.gradle",
    "android/src/main/**",
    "build",
    "expo-module.config.json",
    "ios/*.podspec",
    "ios/*.swift"
  ],
  "scripts": {
    "build": "rm -rf build && tsc -p ./tsconfig.build.json",
    "clean": "rm -rf build",
    "prepack": "yarn run -T turbo run build --filter=$npm_package_name...",
    "lint": "yarn run -T concurrently \"yarn biome:check\" \"yarn tsc:check\"",
    "lint:fix": "yarn run -T biome check --write .",
    "biome:check": "yarn run -T biome check .",
    "tsc:check": "tsc -p ./tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "expo": ">=57",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.14",
    "expo": "~57.0.31",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
